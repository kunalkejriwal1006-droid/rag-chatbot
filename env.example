GEMINI_API_KEY=your_gemini_api_key_here

# Models
# Embeddings run locally (sentence-transformers) - no API key or rate limits.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
GENERATION_MODEL=gemini-2.5-flash

# Paths (relative to project root, override if needed)
PDF_DIR=.
DATA_DIR=./data
COLLECTION_NAME=insurance_motor

# Chunking
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=600
TABLE_ROW_SPLIT_THRESHOLD=8

# Retrieval
TOP_K=8
